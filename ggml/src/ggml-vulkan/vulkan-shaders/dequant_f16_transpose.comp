#version 450

#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout (binding = 0) readonly buffer A {float16_t data_a[];};
layout (binding = 1) writeonly buffer D {f16vec4 data_b[];};

// Strided-copy counterpart of the fused dequant+transpose shaders for FA f16 KV:
// both sides are [HS, KV, NH, NS] (dim1 = KV, dim2 = head); dest is
// per-head-contiguous so the f16 FA reads KV coalesced. Unlike the quant
// variants (which only engage on dense KV), this fires on strided views, so
// the source is indexed with explicit element strides (s1/s2/s3 =
// nb[1..3]/2; the host guarantees dim0 dense and even strides). HS stays
// innermost in both layouts and HS % 8 == 0 (host gate), so each invocation
// moves 8 source-contiguous elements into two vec4 dest slots.
layout (push_constant) uniform parameter
{
    uint HS;
    uint KVn;
    uint NH;
    uint s1;
    uint s2;
    uint s3;
    uint nel;
} p;

void main() {
    const uint i = gl_GlobalInvocationID.x;
    const uint e0 = i * 8;
    if (e0 >= p.nel) {
        return;
    }

    // e0 is a dest-linear index over [HS, KV, NH, NS].
    const uint hs = e0 % p.HS;
    const uint kv = (e0 / p.HS) % p.KVn;
    const uint nh = (e0 / (p.HS * p.KVn)) % p.NH;
    const uint ns = e0 / (p.HS * p.KVn * p.NH);
    const uint src = hs + kv * p.s1 + nh * p.s2 + ns * p.s3;

    // The 8 elements are dim0-contiguous (host gate); dest is vec4-aligned
    // (e0 % 8 == 0).
    const f16vec4 v0 = f16vec4(data_a[src],     data_a[src + 1],
                               data_a[src + 2], data_a[src + 3]);
    const f16vec4 v1 = f16vec4(data_a[src + 4], data_a[src + 5],
                               data_a[src + 6], data_a[src + 7]);
    data_b[e0 / 4]     = v0;
    data_b[e0 / 4 + 1] = v1;
}
